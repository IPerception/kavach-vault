<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.kavach</groupId>
    <artifactId>kavach</artifactId>
    <version>1.3.0</version>
    <packaging>pom</packaging>
    <name>Kavach</name>
    <description>Local-first personal password manager</description>

    <modules>
        <module>kavach-frontend</module>
        <module>kavach-backend</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <jjwt.version>0.13.0</jjwt.version>
        <bucket4j.version>8.23.0</bucket4j.version>
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
        <springdoc.version>3.2.1</springdoc.version>
        <bouncycastle.version>1.87</bouncycastle.version>
    </properties>
</project>
