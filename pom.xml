<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.kavach</groupId>
    <artifactId>kavach</artifactId>
    <version>1.3.0</version>
    <packaging>pom</packaging>
    <name>Kavach</name>
    <description>Local-first personal password manager</description>

    <modules>
        <module>kavach-frontend</module>
        <module>kavach-backend</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <jjwt.version>0.13.0</jjwt.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <springdoc.version>3.1.1</springdoc.version>
        <!--
            Overrides the commons-lang3 version that spring-boot-dependencies applies to
            any transitive use. commons-lang3 is not declared in any of our poms, so this
            property is the only thing controlling it.

            Boot 3.5.14 manages 3.17.0, which is vulnerable to GHSA-j288-q9x7-2f5v
            (uncontrolled recursion DoS, fixed in 3.18.0). Deleting this line silently
            reintroduces that CVE.

            Owned by hand, not by Dependabot: a version defined in the parent and never
            declared in a child gives Dependabot no manifest entry to raise a PR against.

            This is a ceiling as well as a floor. Re-check on every Spring Boot upgrade
            and delete this override once the BOM manages >= 3.18.0, otherwise it will
            start pinning us *below* what Boot ships.
        -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <bouncycastle.version>1.86</bouncycastle.version>
    </properties>
</project>
