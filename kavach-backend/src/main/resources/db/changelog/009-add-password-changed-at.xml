<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        When the password itself last changed (not any field). Nullable because SQLite
        cannot add a NOT NULL column without a constant default; existing rows are
        backfilled from updated_at, the best information available.
    -->
    <changeSet id="012-add-password-changed-at" author="kavach">
        <sql>ALTER TABLE credential ADD COLUMN password_changed_at TIMESTAMP</sql>
        <sql>UPDATE credential SET password_changed_at = updated_at</sql>
    </changeSet>

</databaseChangeLog>
